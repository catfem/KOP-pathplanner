{
  "name": "kop-pathplanner",
  "private": true,
  "version": "1.0.0",
  "description": "Web-based autonomous path planner and code generator for the FRC Kit-of-Parts (KOP) differential drive chassis. Works without a gyroscope.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:codegen": "tools/verify/run.sh"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/node": "22.20.5",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
